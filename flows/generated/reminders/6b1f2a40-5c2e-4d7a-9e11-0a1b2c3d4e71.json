{
 "workflowid": "6b1f2a40-5c2e-4d7a-9e11-0a1b2c3d4e71",
 "name": "AACA - Teacher Attendance Reminder",
 "clientdata": {
  "properties": {
   "connectionReferences": {
    "shared_commondataserviceforapps": {
     "runtimeSource": "embedded",
     "connection": {
      "connectionReferenceLogicalName": "aaca_sharedcommondataserviceforapps_2b783"
     },
     "api": {
      "name": "shared_commondataserviceforapps"
     }
    },
    "shared_teams": {
     "runtimeSource": "embedded",
     "connection": {
      "connectionReferenceLogicalName": "aaca_sharedteams_reminders"
     },
     "api": {
      "name": "shared_teams"
     }
    }
   },
   "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
     "$connections": {
      "defaultValue": {},
      "type": "Object"
     },
     "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
     }
    },
    "triggers": {
     "Schedule": {
      "metadata": {
       "operationMetadataId": "b10eebe1-2230-477b-baf3-bd8c227dcf45"
      },
      "type": "Recurrence",
      "recurrence": {
       "frequency": "Week",
       "interval": 1,
       "timeZone": "Pacific Standard Time",
       "schedule": {
        "weekDays": [
         "Monday",
         "Tuesday",
         "Wednesday",
         "Thursday",
         "Friday"
        ],
        "hours": [
         "10"
        ],
        "minutes": [
         0
        ]
       }
      }
     }
    },
    "actions": {
     "Today": {
      "runAfter": {},
      "metadata": {
       "operationMetadataId": "99157754-6771-467b-9960-e6d301a7baa9"
      },
      "type": "Compose",
      "inputs": "@convertFromUtc(utcNow(), 'Pacific Standard Time', 'yyyy-MM-dd')"
     },
     "Campuses": {
      "runAfter": {
       "Today": [
        "Succeeded"
       ]
      },
      "metadata": {
       "operationMetadataId": "f90aaac3-01fe-405d-9779-39f17309d07d"
      },
      "type": "OpenApiConnection",
      "inputs": {
       "host": {
        "connectionName": "shared_commondataserviceforapps",
        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
        "operationId": "ListRecords"
       },
       "parameters": {
        "entityName": "aaca_campuses",
        "$select": "aaca_campusid,aaca_name",
        "$filter": "aaca_active eq true"
       },
       "authentication": "@parameters('$authentication')"
      }
     },
     "Each_campus": {
      "runAfter": {
       "Campuses": [
        "Succeeded"
       ]
      },
      "metadata": {
       "operationMetadataId": "d22286b1-762c-4d85-9058-a5751d918fe9"
      },
      "type": "Foreach",
      "foreach": "@body('Campuses')?['value']",
      "actions": {
       "Term": {
        "runAfter": {},
        "metadata": {
         "operationMetadataId": "47305166-aac3-4da4-b412-e2a4e2e8652f"
        },
        "type": "OpenApiConnection",
        "inputs": {
         "host": {
          "connectionName": "shared_commondataserviceforapps",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
          "operationId": "ListRecords"
         },
         "parameters": {
          "entityName": "aaca_terms",
          "$select": "aaca_termid",
          "$filter": "aaca_term ne 582100005 and _aaca_campus_value eq @{items('Each_campus')?['aaca_campusid']} and aaca_startdate le @{outputs('Today')} and aaca_enddate ge @{outputs('Today')}"
         },
         "authentication": "@parameters('$authentication')"
        }
       },
       "Exceptions": {
        "runAfter": {},
        "metadata": {
         "operationMetadataId": "d76adff4-ecaf-4892-ad01-cb853cbf0a1f"
        },
        "type": "OpenApiConnection",
        "inputs": {
         "host": {
          "connectionName": "shared_commondataserviceforapps",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
          "operationId": "ListRecords"
         },
         "parameters": {
          "entityName": "aaca_calendarexceptions",
          "$select": "aaca_type",
          "$filter": "aaca_date eq @{outputs('Today')} and (_aaca_campus_value eq @{items('Each_campus')?['aaca_campusid']} or _aaca_campus_value eq null)"
         },
         "authentication": "@parameters('$authentication')"
        }
       },
       "Makeup": {
        "runAfter": {
         "Exceptions": [
          "Succeeded"
         ]
        },
        "metadata": {
         "operationMetadataId": "5b04de60-aae1-4aeb-b685-ae774640a11c"
        },
        "type": "Query",
        "inputs": {
         "from": "@body('Exceptions')?['value']",
         "where": "@equals(item()?['aaca_type'], 582100004)"
        }
       },
       "School_day": {
        "runAfter": {
         "Term": [
          "Succeeded"
         ],
         "Makeup": [
          "Succeeded"
         ]
        },
        "metadata": {
         "operationMetadataId": "6f8c3ad2-8808-4bf8-b6bb-4a1703f37762"
        },
        "type": "Compose",
        "inputs": "@and(not(empty(body('Term')?['value'])), or(not(empty(body('Makeup'))), and(not(or(equals(dayOfWeek(outputs('Today')), 0), equals(dayOfWeek(outputs('Today')), 6))), equals(length(body('Makeup')), length(body('Exceptions')?['value'])))))"
       },
       "If_school_day": {
        "runAfter": {
         "School_day": [
          "Succeeded"
         ]
        },
        "metadata": {
         "operationMetadataId": "7ba067a4-0862-4d8e-b351-b2d8b1783f85"
        },
        "type": "If",
        "expression": {
         "and": [
          {
           "equals": [
            "@outputs('School_day')",
            true
           ]
          }
         ]
        },
        "actions": {
         "Enrolled": {
          "runAfter": {},
          "metadata": {
           "operationMetadataId": "56c56eb8-3d84-4242-ac72-f56028b2e529"
          },
          "type": "OpenApiConnection",
          "inputs": {
           "host": {
            "connectionName": "shared_commondataserviceforapps",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
            "operationId": "ListRecords"
           },
           "parameters": {
            "entityName": "aaca_enrollments",
            "$select": "_aaca_student_value,_aaca_teacher_value",
            "$filter": "_aaca_campus_value eq @{items('Each_campus')?['aaca_campusid']} and aaca_startdate le @{outputs('Today')} and (aaca_enddate eq null or aaca_enddate ge @{outputs('Today')})",
            "$expand": "aaca_student($select=aaca_displayname),aaca_teacher($select=aaca_name)"
           },
           "authentication": "@parameters('$authentication')"
          }
         },
         "Marked": {
          "runAfter": {},
          "metadata": {
           "operationMetadataId": "0505849f-aac7-4988-a531-30cbd9dd0c0b"
          },
          "type": "OpenApiConnection",
          "inputs": {
           "host": {
            "connectionName": "shared_commondataserviceforapps",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
            "operationId": "ListRecords"
           },
           "parameters": {
            "entityName": "aaca_attendances",
            "$select": "_aaca_student_value",
            "$filter": "_aaca_campus_value eq @{items('Each_campus')?['aaca_campusid']} and aaca_date eq @{outputs('Today')} and aaca_isdeleted eq false"
           },
           "authentication": "@parameters('$authentication')"
          }
         },
         "Marked_ids": {
          "runAfter": {
           "Marked": [
            "Succeeded"
           ]
          },
          "metadata": {
           "operationMetadataId": "c12013b5-fa1f-4f56-947e-9b902ac23959"
          },
          "type": "Select",
          "inputs": {
           "from": "@body('Marked')?['value']",
           "select": "@item()?['_aaca_student_value']"
          }
         },
         "Unmarked": {
          "runAfter": {
           "Enrolled": [
            "Succeeded"
           ],
           "Marked_ids": [
            "Succeeded"
           ]
          },
          "metadata": {
           "operationMetadataId": "304dd7d8-b4e3-476a-ab09-c9ae0fc47de2"
          },
          "type": "Query",
          "inputs": {
           "from": "@body('Enrolled')?['value']",
           "where": "@not(contains(body('Marked_ids'), item()?['_aaca_student_value']))"
          }
         },
         "Teacher_ids": {
          "runAfter": {
           "Unmarked": [
            "Succeeded"
           ]
          },
          "metadata": {
           "operationMetadataId": "7ef00110-4733-4d92-829f-9b067eb49195"
          },
          "type": "Select",
          "inputs": {
           "from": "@body('Unmarked')",
           "select": "@item()?['_aaca_teacher_value']"
          }
         },
         "Each_teacher": {
          "runAfter": {
           "Teacher_ids": [
            "Succeeded"
           ]
          },
          "metadata": {
           "operationMetadataId": "41b257fd-6f40-49b4-87aa-839058a5aa8f"
          },
          "type": "Foreach",
          "foreach": "@union(body('Teacher_ids'), body('Teacher_ids'))",
          "actions": {
           "Teacher": {
            "runAfter": {},
            "metadata": {
             "operationMetadataId": "233d7130-9180-45f0-a380-5edfc4a00cfe"
            },
            "type": "OpenApiConnection",
            "inputs": {
             "host": {
              "connectionName": "shared_commondataserviceforapps",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "ListRecords"
             },
             "parameters": {
              "entityName": "aaca_staffs",
              "$select": "aaca_name,aaca_email,aaca_active",
              "$filter": "aaca_staffid eq @{items('Each_teacher')} and aaca_active eq true",
              "$expand": "aaca_user($select=internalemailaddress)"
             },
             "authentication": "@parameters('$authentication')"
            }
           },
           "Teacher_email": {
            "runAfter": {
             "Teacher": [
              "Succeeded"
             ]
            },
            "metadata": {
             "operationMetadataId": "55c0f3d5-6fb5-4b17-84d7-ac9a32b8bf8c"
            },
            "type": "Select",
            "inputs": {
             "from": "@body('Teacher')?['value']",
             "select": "@coalesce(item()?['aaca_email'], item()?['aaca_user']?['internalemailaddress'])"
            }
           },
           "Their_students": {
            "runAfter": {},
            "metadata": {
             "operationMetadataId": "5dd4dfa1-f606-4770-854c-142ed908509e"
            },
            "type": "Query",
            "inputs": {
             "from": "@body('Unmarked')",
             "where": "@equals(item()?['_aaca_teacher_value'], items('Each_teacher'))"
            }
           },
           "Their_names": {
            "runAfter": {
             "Their_students": [
              "Succeeded"
             ]
            },
            "metadata": {
             "operationMetadataId": "aa710292-92dd-4857-8be2-3243302cdc0c"
            },
            "type": "Select",
            "inputs": {
             "from": "@body('Their_students')",
             "select": "@item()?['aaca_student']?['aaca_displayname']"
            }
           },
           "Has_email": {
            "runAfter": {
             "Teacher_email": [
              "Succeeded"
             ],
             "Their_names": [
              "Succeeded"
             ]
            },
            "metadata": {
             "operationMetadataId": "2ef82786-b866-48dc-8a0b-52de69a29ce9"
            },
            "type": "If",
            "expression": {
             "and": [
              {
               "not": {
                "equals": [
                 "@empty(first(body('Teacher_email')))",
                 true
                ]
               }
              }
             ]
            },
            "actions": {
             "Send_teacher": {
              "runAfter": {},
              "metadata": {
               "operationMetadataId": "059af1e1-4a2d-42b8-97df-98bd7abd17e3"
              },
              "type": "OpenApiConnection",
              "inputs": {
               "host": {
                "connectionName": "shared_teams",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                "operationId": "PostMessageToConversation"
               },
               "parameters": {
                "poster": "Flow bot",
                "location": "Chat with Flow bot",
                "body/recipient": "@{first(body('Teacher_email'))}",
                "body/messageBody": "<p>Good morning. Attendance for today (@{formatDateTime(outputs('Today'), 'dddd, MMMM d')}) is not marked yet for @{length(body('Their_students'))} student(s):</p><p><b>@{join(body('Their_names'), ', ')}</b></p><p>Please open the AACA Attendance app and mark them present. Absences reported by parents are already filled in.</p>"
               },
               "authentication": "@parameters('$authentication')"
              }
             }
            },
            "else": {
             "actions": {}
            }
           }
          },
          "runtimeConfiguration": {
           "concurrency": {
            "repetitions": 1
           }
          }
         }
        },
        "else": {
         "actions": {}
        }
       }
      },
      "runtimeConfiguration": {
       "concurrency": {
        "repetitions": 1
       }
      }
     }
    },
    "outputs": {}
   },
   "templateName": null
  },
  "schemaVersion": "1.0.0.0"
 }
}