{
 "workflowid": "6b1f2a40-5c2e-4d7a-9e11-0a1b2c3d4e72",
 "name": "AACA - Office Daily Reminder",
 "clientdata": {
  "properties": {
   "connectionReferences": {
    "shared_commondataserviceforapps": {
     "runtimeSource": "embedded",
     "connection": {
      "connectionReferenceLogicalName": "aaca_sharedcommondataserviceforapps_2b783"
     },
     "api": {
      "name": "shared_commondataserviceforapps"
     }
    },
    "shared_sharepointonline": {
     "runtimeSource": "embedded",
     "connection": {
      "connectionReferenceLogicalName": "aaca_sharedsharepointonline_4204c"
     },
     "api": {
      "name": "shared_sharepointonline"
     }
    },
    "shared_teams": {
     "runtimeSource": "embedded",
     "connection": {
      "connectionReferenceLogicalName": "aaca_sharedteams_reminders"
     },
     "api": {
      "name": "shared_teams"
     }
    }
   },
   "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
     "$connections": {
      "defaultValue": {},
      "type": "Object"
     },
     "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
     }
    },
    "triggers": {
     "Schedule": {
      "metadata": {
       "operationMetadataId": "92f14f98-7e59-4d4a-b6e4-8540e0848951"
      },
      "type": "Recurrence",
      "recurrence": {
       "frequency": "Week",
       "interval": 1,
       "timeZone": "Pacific Standard Time",
       "schedule": {
        "weekDays": [
         "Monday",
         "Tuesday",
         "Wednesday",
         "Thursday",
         "Friday"
        ],
        "hours": [
         "15"
        ],
        "minutes": [
         30
        ]
       }
      }
     }
    },
    "actions": {
     "Today": {
      "runAfter": {},
      "metadata": {
       "operationMetadataId": "99157754-6771-467b-9960-e6d301a7baa9"
      },
      "type": "Compose",
      "inputs": "@convertFromUtc(utcNow(), 'Pacific Standard Time', 'yyyy-MM-dd')"
     },
     "Campuses": {
      "runAfter": {
       "Today": [
        "Succeeded"
       ]
      },
      "metadata": {
       "operationMetadataId": "f90aaac3-01fe-405d-9779-39f17309d07d"
      },
      "type": "OpenApiConnection",
      "inputs": {
       "host": {
        "connectionName": "shared_commondataserviceforapps",
        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
        "operationId": "ListRecords"
       },
       "parameters": {
        "entityName": "aaca_campuses",
        "$select": "aaca_campusid,aaca_name",
        "$filter": "aaca_active eq true"
       },
       "authentication": "@parameters('$authentication')"
      }
     },
     "Needs_review": {
      "runAfter": {
       "Campuses": [
        "Succeeded"
       ]
      },
      "metadata": {
       "operationMetadataId": "63c4d95c-b9fa-4f0a-8a48-87ed58f8aa47"
      },
      "type": "OpenApiConnection",
      "inputs": {
       "host": {
        "connectionName": "shared_sharepointonline",
        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
        "operationId": "GetItems"
       },
       "parameters": {
        "dataset": "https://autismacademy.sharepoint.com/sites/FinanceMain",
        "table": "1058d183-30d4-4fe8-83f6-1c5120edf24f",
        "$filter": "Match_Status eq 'Needs Review'",
        "$top": 5000
       },
       "authentication": "@parameters('$authentication')"
      }
     },
     "Each_campus": {
      "runAfter": {
       "Needs_review": [
        "Succeeded"
       ]
      },
      "metadata": {
       "operationMetadataId": "fe746ef1-0b82-45df-8d9a-51d2a16d5fdd"
      },
      "type": "Foreach",
      "foreach": "@body('Campuses')?['value']",
      "actions": {
       "Term": {
        "runAfter": {},
        "metadata": {
         "operationMetadataId": "cc30adbb-3dff-44bb-a4a6-6ffe1d1af70d"
        },
        "type": "OpenApiConnection",
        "inputs": {
         "host": {
          "connectionName": "shared_commondataserviceforapps",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
          "operationId": "ListRecords"
         },
         "parameters": {
          "entityName": "aaca_terms",
          "$select": "aaca_termid",
          "$filter": "aaca_term ne 582100005 and _aaca_campus_value eq @{items('Each_campus')?['aaca_campusid']} and aaca_startdate le @{outputs('Today')} and aaca_enddate ge @{outputs('Today')}"
         },
         "authentication": "@parameters('$authentication')"
        }
       },
       "Exceptions": {
        "runAfter": {},
        "metadata": {
         "operationMetadataId": "ce61f3da-c036-4821-9d60-0b02fe30d464"
        },
        "type": "OpenApiConnection",
        "inputs": {
         "host": {
          "connectionName": "shared_commondataserviceforapps",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
          "operationId": "ListRecords"
         },
         "parameters": {
          "entityName": "aaca_calendarexceptions",
          "$select": "aaca_type",
          "$filter": "aaca_date eq @{outputs('Today')} and (_aaca_campus_value eq @{items('Each_campus')?['aaca_campusid']} or _aaca_campus_value eq null)"
         },
         "authentication": "@parameters('$authentication')"
        }
       },
       "Makeup": {
        "runAfter": {
         "Exceptions": [
          "Succeeded"
         ]
        },
        "metadata": {
         "operationMetadataId": "b151f5ec-db39-4f97-b243-909138c98e1b"
        },
        "type": "Query",
        "inputs": {
         "from": "@body('Exceptions')?['value']",
         "where": "@equals(item()?['aaca_type'], 582100004)"
        }
       },
       "School_day": {
        "runAfter": {
         "Term": [
          "Succeeded"
         ],
         "Makeup": [
          "Succeeded"
         ]
        },
        "metadata": {
         "operationMetadataId": "11f29cd0-c2a6-4f31-b49a-ceca5877a623"
        },
        "type": "Compose",
        "inputs": "@and(not(empty(body('Term')?['value'])), or(not(empty(body('Makeup'))), and(not(or(equals(dayOfWeek(outputs('Today')), 0), equals(dayOfWeek(outputs('Today')), 6))), equals(length(body('Makeup')), length(body('Exceptions')?['value'])))))"
       },
       "If_school_day": {
        "runAfter": {
         "School_day": [
          "Succeeded"
         ]
        },
        "metadata": {
         "operationMetadataId": "12451fd2-20ce-415e-b346-eb6b85fc1fa6"
        },
        "type": "If",
        "expression": {
         "and": [
          {
           "equals": [
            "@outputs('School_day')",
            true
           ]
          }
         ]
        },
        "actions": {
         "Enrolled": {
          "runAfter": {},
          "metadata": {
           "operationMetadataId": "22de54f5-a263-42f9-9640-509d03766334"
          },
          "type": "OpenApiConnection",
          "inputs": {
           "host": {
            "connectionName": "shared_commondataserviceforapps",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
            "operationId": "ListRecords"
           },
           "parameters": {
            "entityName": "aaca_enrollments",
            "$select": "_aaca_student_value,_aaca_teacher_value",
            "$filter": "_aaca_campus_value eq @{items('Each_campus')?['aaca_campusid']} and aaca_startdate le @{outputs('Today')} and (aaca_enddate eq null or aaca_enddate ge @{outputs('Today')})",
            "$expand": "aaca_student($select=aaca_displayname),aaca_teacher($select=aaca_name)"
           },
           "authentication": "@parameters('$authentication')"
          }
         },
         "Marked": {
          "runAfter": {},
          "metadata": {
           "operationMetadataId": "3abed5a3-b0a7-415d-8cf7-ad6fb75737cb"
          },
          "type": "OpenApiConnection",
          "inputs": {
           "host": {
            "connectionName": "shared_commondataserviceforapps",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
            "operationId": "ListRecords"
           },
           "parameters": {
            "entityName": "aaca_attendances",
            "$select": "_aaca_student_value",
            "$filter": "_aaca_campus_value eq @{items('Each_campus')?['aaca_campusid']} and aaca_date eq @{outputs('Today')} and aaca_isdeleted eq false"
           },
           "authentication": "@parameters('$authentication')"
          }
         },
         "Marked_ids": {
          "runAfter": {
           "Marked": [
            "Succeeded"
           ]
          },
          "metadata": {
           "operationMetadataId": "5b3ea891-873e-4a60-a093-d7924bf1c54c"
          },
          "type": "Select",
          "inputs": {
           "from": "@body('Marked')?['value']",
           "select": "@item()?['_aaca_student_value']"
          }
         },
         "Unmarked": {
          "runAfter": {
           "Enrolled": [
            "Succeeded"
           ],
           "Marked_ids": [
            "Succeeded"
           ]
          },
          "metadata": {
           "operationMetadataId": "7a64c1d2-940f-4d55-95e6-2a8b6185427b"
          },
          "type": "Query",
          "inputs": {
           "from": "@body('Enrolled')?['value']",
           "where": "@not(contains(body('Marked_ids'), item()?['_aaca_student_value']))"
          }
         },
         "To_classify": {
          "runAfter": {},
          "metadata": {
           "operationMetadataId": "71e06791-e94f-4021-ac35-0c65b06b1a9f"
          },
          "type": "OpenApiConnection",
          "inputs": {
           "host": {
            "connectionName": "shared_commondataserviceforapps",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
            "operationId": "ListRecords"
           },
           "parameters": {
            "entityName": "aaca_attendances",
            "$select": "aaca_attendanceid",
            "$filter": "_aaca_campus_value eq @{items('Each_campus')?['aaca_campusid']} and aaca_present eq false and aaca_isdeleted eq false and aaca_classification eq null and aaca_date ge 2026-01-01 and aaca_date le @{outputs('Today')}"
           },
           "authentication": "@parameters('$authentication')"
          }
         },
         "Conflicts": {
          "runAfter": {},
          "metadata": {
           "operationMetadataId": "35a10deb-7378-493b-86e1-18a524c8c674"
          },
          "type": "OpenApiConnection",
          "inputs": {
           "host": {
            "connectionName": "shared_commondataserviceforapps",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
            "operationId": "ListRecords"
           },
           "parameters": {
            "entityName": "aaca_attendances",
            "$select": "aaca_attendanceid",
            "$filter": "_aaca_campus_value eq @{items('Each_campus')?['aaca_campusid']} and aaca_present eq true and aaca_parentreportedabsent eq true and aaca_isdeleted eq false and aaca_date ge 2026-01-01"
           },
           "authentication": "@parameters('$authentication')"
          }
         },
         "Campus_errors": {
          "runAfter": {},
          "metadata": {
           "operationMetadataId": "382283bd-cbde-4111-9ef3-8aa7bacce154"
          },
          "type": "Query",
          "inputs": {
           "from": "@body('Needs_review')?['value']",
           "where": "@equals(toLower(trim(coalesce(item()?['SchoolSite'], ''))), toLower(items('Each_campus')?['aaca_name']))"
          }
         },
         "Recipients_office": {
          "runAfter": {},
          "metadata": {
           "operationMetadataId": "3abcc7ba-7f02-4b3d-b539-d23fabdd839f"
          },
          "type": "OpenApiConnection",
          "inputs": {
           "host": {
            "connectionName": "shared_commondataserviceforapps",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
            "operationId": "ListRecords"
           },
           "parameters": {
            "entityName": "aaca_staffs",
            "$select": "aaca_name,aaca_email",
            "$filter": "_aaca_campus_value eq @{items('Each_campus')?['aaca_campusid']} and aaca_approle eq 582100001 and aaca_active eq true",
            "$expand": "aaca_user($select=internalemailaddress)"
           },
           "authentication": "@parameters('$authentication')"
          }
         },
         "Recipients_admin": {
          "runAfter": {},
          "metadata": {
           "operationMetadataId": "94541049-9f23-4850-9e51-c09396e04fa6"
          },
          "type": "OpenApiConnection",
          "inputs": {
           "host": {
            "connectionName": "shared_commondataserviceforapps",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
            "operationId": "ListRecords"
           },
           "parameters": {
            "entityName": "aaca_staffs",
            "$select": "aaca_name,aaca_email",
            "$filter": "_aaca_campus_value eq @{items('Each_campus')?['aaca_campusid']} and aaca_siteadministrator eq true and aaca_active eq true",
            "$expand": "aaca_user($select=internalemailaddress)"
           },
           "authentication": "@parameters('$authentication')"
          }
         },
         "Unmarked_teachers": {
          "runAfter": {
           "Unmarked": [
            "Succeeded"
           ]
          },
          "metadata": {
           "operationMetadataId": "2e0118fd-967b-474c-bd64-9f9256c7172e"
          },
          "type": "Select",
          "inputs": {
           "from": "@body('Unmarked')",
           "select": "@item()?['aaca_teacher']?['aaca_name']"
          }
         },
         "Transport_active": {
          "runAfter": {},
          "metadata": {
           "operationMetadataId": "90445869-3456-41e0-aa7a-9bea508a506b"
          },
          "type": "OpenApiConnection",
          "inputs": {
           "host": {
            "connectionName": "shared_commondataserviceforapps",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
            "operationId": "ListRecords"
           },
           "parameters": {
            "entityName": "aaca_studenttransports",
            "$select": "_aaca_student_value",
            "$filter": "_aaca_campus_value eq @{items('Each_campus')?['aaca_campusid']} and aaca_startdate le @{outputs('Today')} and (aaca_enddate eq null or aaca_enddate ge @{outputs('Today')})"
           },
           "authentication": "@parameters('$authentication')"
          }
         },
         "Transport_logged": {
          "runAfter": {},
          "metadata": {
           "operationMetadataId": "f11e8077-9471-4f9e-b30e-d09b1a15ccee"
          },
          "type": "OpenApiConnection",
          "inputs": {
           "host": {
            "connectionName": "shared_commondataserviceforapps",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
            "operationId": "ListRecords"
           },
           "parameters": {
            "entityName": "aaca_transportlogs",
            "$select": "_aaca_student_value",
            "$filter": "_aaca_campus_value eq @{items('Each_campus')?['aaca_campusid']} and aaca_date eq @{outputs('Today')}"
           },
           "authentication": "@parameters('$authentication')"
          }
         },
         "Logged_ids": {
          "runAfter": {
           "Transport_logged": [
            "Succeeded"
           ]
          },
          "metadata": {
           "operationMetadataId": "a6f8e486-ffd4-4272-879e-9455b5123a3e"
          },
          "type": "Select",
          "inputs": {
           "from": "@body('Transport_logged')?['value']",
           "select": "@item()?['_aaca_student_value']"
          }
         },
         "Enrolled_ids": {
          "runAfter": {
           "Enrolled": [
            "Succeeded"
           ]
          },
          "metadata": {
           "operationMetadataId": "0315f8ad-d544-4be2-b552-52a64024c17c"
          },
          "type": "Select",
          "inputs": {
           "from": "@body('Enrolled')?['value']",
           "select": "@item()?['_aaca_student_value']"
          }
         },
         "Transport_open": {
          "runAfter": {
           "Transport_active": [
            "Succeeded"
           ],
           "Logged_ids": [
            "Succeeded"
           ],
           "Enrolled_ids": [
            "Succeeded"
           ]
          },
          "metadata": {
           "operationMetadataId": "9b2220dc-41cf-4bc3-b875-037fb5d3088a"
          },
          "type": "Query",
          "inputs": {
           "from": "@body('Transport_active')?['value']",
           "where": "@and(contains(body('Enrolled_ids'), item()?['_aaca_student_value']), not(contains(body('Logged_ids'), item()?['_aaca_student_value'])))"
          }
         },
         "Total_open": {
          "runAfter": {
           "Unmarked": [
            "Succeeded"
           ],
           "To_classify": [
            "Succeeded"
           ],
           "Conflicts": [
            "Succeeded"
           ],
           "Transport_open": [
            "Succeeded"
           ],
           "Campus_errors": [
            "Succeeded"
           ]
          },
          "metadata": {
           "operationMetadataId": "1ceda5b3-e891-4bf9-ab12-440c340c8484"
          },
          "type": "Compose",
          "inputs": "@add(add(add(length(body('Unmarked')), length(body('To_classify')?['value'])), add(length(body('Conflicts')?['value']), length(body('Transport_open')))), length(body('Campus_errors')))"
         },
         "Message": {
          "runAfter": {
           "Total_open": [
            "Succeeded"
           ],
           "Unmarked_teachers": [
            "Succeeded"
           ]
          },
          "metadata": {
           "operationMetadataId": "41481bcd-94d2-4d69-ae8a-8a3954a497b2"
          },
          "type": "Compose",
          "inputs": "<p>End-of-day check for <b>@{items('Each_campus')?['aaca_name']}</b>, @{formatDateTime(outputs('Today'), 'dddd, MMMM d')}:</p><ul>@{if(greater(length(body('Unmarked')), 0), concat('<li>Attendance not marked: <b>', length(body('Unmarked')), '</b> student(s) (', join(union(body('Unmarked_teachers'), body('Unmarked_teachers')), ', '), ')</li>'), '')}@{if(greater(length(body('To_classify')?['value']), 0), concat('<li>Absences to classify: <b>', length(body('To_classify')?['value']), '</b></li>'), '')}@{if(greater(length(body('Conflicts')?['value']), 0), concat('<li>Parent reported absent but marked present (Needs a decision): <b>', length(body('Conflicts')?['value']), '</b></li>'), '')}@{if(greater(length(body('Transport_open')), 0), concat('<li>Transportation not confirmed today: <b>', length(body('Transport_open')), '</b> student(s)</li>'), '')}@{if(greater(length(body('Campus_errors')), 0), concat('<li>Parent reports in Mapping Errors: <b>', length(body('Campus_errors')), '</b></li>'), '')}</ul><p>Please finish these in the AACA Attendance app before the end of the day.</p>"
         },
         "Anything_open": {
          "runAfter": {
           "Message": [
            "Succeeded"
           ],
           "Recipients_office": [
            "Succeeded"
           ]
          },
          "metadata": {
           "operationMetadataId": "bc15df6f-e925-4ceb-a95d-3204e57039ca"
          },
          "type": "If",
          "expression": {
           "and": [
            {
             "greater": [
              "@outputs('Total_open')",
              0
             ]
            }
           ]
          },
          "actions": {
           "Office_emails": {
            "runAfter": {},
            "metadata": {
             "operationMetadataId": "efa759b7-fe0d-4e05-8251-b25b99780c8e"
            },
            "type": "Select",
            "inputs": {
             "from": "@body('Recipients_office')?['value']",
             "select": "@coalesce(item()?['aaca_email'], item()?['aaca_user']?['internalemailaddress'])"
            }
           },
           "Each_office": {
            "runAfter": {
             "Office_emails": [
              "Succeeded"
             ]
            },
            "metadata": {
             "operationMetadataId": "5c94c95b-c2b8-42e9-acf7-5da08863257a"
            },
            "type": "Foreach",
            "foreach": "@body('Office_emails')",
            "actions": {
             "Send_office": {
              "runAfter": {},
              "metadata": {
               "operationMetadataId": "f8a13ccd-cb83-42d5-83cc-c73981cf4e9c"
              },
              "type": "If",
              "expression": {
               "and": [
                {
                 "not": {
                  "equals": [
                   "@empty(item())",
                   true
                  ]
                 }
                }
               ]
              },
              "actions": {
               "Post_office": {
                "runAfter": {},
                "metadata": {
                 "operationMetadataId": "ca6f993d-0b99-42f8-8916-2917322d4147"
                },
                "type": "OpenApiConnection",
                "inputs": {
                 "host": {
                  "connectionName": "shared_teams",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                  "operationId": "PostMessageToConversation"
                 },
                 "parameters": {
                  "poster": "Flow bot",
                  "location": "Chat with Flow bot",
                  "body/recipient": "@{items('Each_office')}",
                  "body/messageBody": "@{outputs('Message')}"
                 },
                 "authentication": "@parameters('$authentication')"
                }
               }
              },
              "else": {
               "actions": {}
              }
             }
            },
            "runtimeConfiguration": {
             "concurrency": {
              "repetitions": 1
             }
            }
           }
          },
          "else": {
           "actions": {}
          }
         }
        },
        "else": {
         "actions": {}
        }
       }
      },
      "runtimeConfiguration": {
       "concurrency": {
        "repetitions": 1
       }
      }
     }
    },
    "outputs": {}
   },
   "templateName": null
  },
  "schemaVersion": "1.0.0.0"
 }
}