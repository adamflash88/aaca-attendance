{
 "workflowid": "6b1f2a40-5c2e-4d7a-9e11-0a1b2c3d4e91",
 "name": "AACA - Website Absence Intake",
 "clientdata": {
  "properties": {
   "connectionReferences": {
    "shared_commondataserviceforapps": {
     "runtimeSource": "embedded",
     "connection": {
      "connectionReferenceLogicalName": "aaca_sharedcommondataserviceforapps_2b783"
     },
     "api": {
      "name": "shared_commondataserviceforapps"
     }
    }
   },
   "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
     "$connections": {
      "defaultValue": {},
      "type": "Object"
     },
     "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
     }
    },
    "triggers": {
     "manual": {
      "metadata": {
       "operationMetadataId": "86c7e049-e35e-4afe-ade1-20f3deb5e75e"
      },
      "type": "Request",
      "kind": "Http",
      "inputs": {
       "triggerAuthenticationType": "All",
       "schema": {
        "type": "object",
        "properties": {
         "data": {
          "type": "object",
          "properties": {
           "FN": {
            "type": "string"
           },
           "LN": {
            "type": "string"
           },
           "DOA": {
            "type": "string"
           },
           "RETURN": {
            "type": "string"
           },
           "School": {
            "type": "string"
           },
           "Reason": {
            "type": "string"
           },
           "DN": {
            "type": "string"
           },
           "PN": {
            "type": "string"
           },
           "Relationship": {
            "type": "string"
           }
          }
         }
        }
       }
      }
     }
    },
    "actions": {
     "Campus": {
      "runAfter": {},
      "metadata": {
       "operationMetadataId": "83322dff-4032-420f-8668-1cfd2e307ab0"
      },
      "type": "OpenApiConnection",
      "inputs": {
       "host": {
        "connectionName": "shared_commondataserviceforapps",
        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
        "operationId": "ListRecords"
       },
       "parameters": {
        "entityName": "aaca_campuses",
        "$select": "aaca_campusid,aaca_name,aaca_ownerteamid",
        "$filter": "aaca_active eq true and aaca_name eq '@{replace(trim(coalesce(triggerBody()?['data']?['School'], '')), '''', '''''')}'",
        "$top": 1
       },
       "authentication": "@parameters('$authentication')"
      }
     },
     "Check": {
      "runAfter": {
       "Campus": [
        "Succeeded"
       ]
      },
      "metadata": {
       "operationMetadataId": "eadb45d4-b931-4c87-b016-f0155afd1a90"
      },
      "type": "Scope",
      "actions": {
       "Absence_date": {
        "runAfter": {},
        "metadata": {
         "operationMetadataId": "0960e5ac-a3b8-4ac4-8f7f-e50ab49178a2"
        },
        "type": "Compose",
        "inputs": "@formatDateTime(triggerBody()?['data']?['DOA'], 'yyyy-MM-dd')"
       },
       "Return_date": {
        "runAfter": {
         "Absence_date": [
          "Succeeded"
         ]
        },
        "metadata": {
         "operationMetadataId": "2829210b-8b2b-453a-9a39-7dc8b35ca81f"
        },
        "type": "Compose",
        "inputs": "@if(empty(trim(coalesce(triggerBody()?['data']?['RETURN'], ''))), addDays(outputs('Absence_date'), 1, 'yyyy-MM-dd'), formatDateTime(triggerBody()?['data']?['RETURN'], 'yyyy-MM-dd'))"
       },
       "Is_valid": {
        "runAfter": {
         "Return_date": [
          "Succeeded"
         ]
        },
        "metadata": {
         "operationMetadataId": "2d930d3d-aa04-4fbb-a087-b34842be334c"
        },
        "type": "Compose",
        "inputs": "@and(not(empty(trim(coalesce(triggerBody()?['data']?['FN'], '')))), not(empty(trim(coalesce(triggerBody()?['data']?['LN'], '')))), not(empty(body('Campus')?['value'])), greater(outputs('Return_date'), outputs('Absence_date')), lessOrEquals(div(sub(ticks(outputs('Return_date')), ticks(outputs('Absence_date'))), 864000000000), 60))"
       }
      }
     },
     "Bad_request": {
      "runAfter": {
       "Check": [
        "Failed",
        "TimedOut"
       ]
      },
      "metadata": {
       "operationMetadataId": "acc9d446-de75-4beb-be0e-93f07f12f3de"
      },
      "type": "Response",
      "kind": "Http",
      "inputs": {
       "statusCode": 400,
       "headers": {
        "Content-Type": "application/json"
       },
       "body": {
        "ok": false,
        "error": "Missing or invalid name, school or dates."
       }
      }
     },
     "If_valid": {
      "runAfter": {
       "Check": [
        "Succeeded"
       ]
      },
      "metadata": {
       "operationMetadataId": "e1489304-d76a-46ff-ab77-4a7e27ecd558"
      },
      "type": "If",
      "expression": {
       "and": [
        {
         "equals": [
          "@outputs('Is_valid')",
          true
         ]
        }
       ]
      },
      "actions": {
       "Enrollments_on_day": {
        "runAfter": {},
        "metadata": {
         "operationMetadataId": "b8acba66-37fe-449a-90a1-5ede33f445bf"
        },
        "type": "OpenApiConnection",
        "inputs": {
         "host": {
          "connectionName": "shared_commondataserviceforapps",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
          "operationId": "ListRecords"
         },
         "parameters": {
          "entityName": "aaca_enrollments",
          "$select": "_aaca_student_value",
          "$filter": "_aaca_campus_value eq @{first(body('Campus')?['value'])?['aaca_campusid']} and aaca_startdate le @{outputs('Absence_date')} and (aaca_enddate eq null or aaca_enddate ge @{outputs('Absence_date')})",
          "$expand": "aaca_student($select=aaca_studentid,aaca_firstname,aaca_lastname,aaca_status)"
         },
         "authentication": "@parameters('$authentication')"
        }
       },
       "Name_matches": {
        "runAfter": {
         "Enrollments_on_day": [
          "Succeeded"
         ]
        },
        "metadata": {
         "operationMetadataId": "55ad0b2c-c6e5-4a29-a3b3-b254d7c854d5"
        },
        "type": "Query",
        "inputs": {
         "from": "@body('Enrollments_on_day')?['value']",
         "where": "@and(equals(toLower(trim(replace(replace(replace(coalesce(item()?['aaca_student']?['aaca_firstname'], ''), '-', ' '), '  ', ' '), '  ', ' '))), toLower(trim(replace(replace(replace(coalesce(triggerBody()?['data']?['FN'], ''), '-', ' '), '  ', ' '), '  ', ' ')))), equals(toLower(trim(replace(replace(replace(coalesce(item()?['aaca_student']?['aaca_lastname'], ''), '-', ' '), '  ', ' '), '  ', ' '))), toLower(trim(replace(replace(replace(coalesce(triggerBody()?['data']?['LN'], ''), '-', ' '), '  ', ' '), '  ', ' ')))), not(equals(item()?['aaca_student']?['aaca_status'], 582100002)))"
        }
       },
       "Match_ids": {
        "runAfter": {
         "Name_matches": [
          "Succeeded"
         ]
        },
        "metadata": {
         "operationMetadataId": "486e07c4-3950-4417-aeea-af30e9521d11"
        },
        "type": "Select",
        "inputs": {
         "from": "@body('Name_matches')",
         "select": "@item()?['_aaca_student_value']"
        }
       },
       "Create_notice": {
        "runAfter": {
         "Match_ids": [
          "Succeeded"
         ]
        },
        "metadata": {
         "operationMetadataId": "02732110-7b3f-4c89-8f69-cf2c524b601a"
        },
        "type": "OpenApiConnection",
        "inputs": {
         "host": {
          "connectionName": "shared_commondataserviceforapps",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
          "operationId": "CreateRecord"
         },
         "parameters": {
          "entityName": "aaca_absencenotices",
          "item/aaca_name": "@{take(concat(trim(triggerBody()?['data']?['FN']), ' ', trim(triggerBody()?['data']?['LN']), ' - absent ', formatDateTime(outputs('Absence_date'), 'M/d/yyyy')), 200)}",
          "item/aaca_source": 582100000,
          "item/aaca_status": 582100000,
          "item/aaca_noticeat": "@{trigger()?['startTime']}",
          "item/aaca_websitesubmittedat": "@if(empty(coalesce(triggerBody()?['data']?['DN'], '')), null, triggerBody()?['data']?['DN'])",
          "item/aaca_absencestart": "@{outputs('Absence_date')}",
          "item/aaca_absenceend": "@{addDays(outputs('Return_date'), -1, 'yyyy-MM-dd')}",
          "item/aaca_returndate": "@{outputs('Return_date')}",
          "item/aaca_typedfirstname": "@{take(trim(triggerBody()?['data']?['FN']), 100)}",
          "item/aaca_typedlastname": "@{take(trim(triggerBody()?['data']?['LN']), 100)}",
          "item/aaca_typedcampus": "@{take(trim(triggerBody()?['data']?['School']), 100)}",
          "item/aaca_parentname": "@{take(trim(coalesce(triggerBody()?['data']?['PN'], '')), 200)}",
          "item/aaca_relationshiptext": "@{take(trim(coalesce(triggerBody()?['data']?['Relationship'], '')), 100)}",
          "item/aaca_reasontext": "@{take(coalesce(triggerBody()?['data']?['Reason'], ''), 4000)}",
          "item/aaca_matchstatus": "@if(equals(length(union(body('Match_ids'), body('Match_ids'))), 1), 582100000, if(equals(length(union(body('Match_ids'), body('Match_ids'))), 0), 582100001, 582100002))",
          "item/aaca_matchdetail": "@{if(equals(length(union(body('Match_ids'), body('Match_ids'))), 1), 'Matched on name and campus', if(equals(length(union(body('Match_ids'), body('Match_ids'))), 0), concat('No student enrolled at ', first(body('Campus')?['value'])?['aaca_name'], ' on that date with this name'), concat(length(union(body('Match_ids'), body('Match_ids'))), ' students at ', first(body('Campus')?['value'])?['aaca_name'], ' have this name')))}",
          "item/aaca_campus@odata.bind": "@{concat('/aaca_campuses(', first(body('Campus')?['value'])?['aaca_campusid'], ')')}",
          "item/aaca_student@odata.bind": "@if(equals(length(union(body('Match_ids'), body('Match_ids'))), 1), concat('/aaca_students(', first(union(body('Match_ids'), body('Match_ids'))), ')'), null)",
          "item/ownerid@odata.bind": "@if(empty(first(body('Campus')?['value'])?['aaca_ownerteamid']), null, concat('/teams(', first(body('Campus')?['value'])?['aaca_ownerteamid'], ')'))"
         },
         "authentication": "@parameters('$authentication')"
        }
       },
       "Accepted": {
        "runAfter": {
         "Create_notice": [
          "Succeeded"
         ]
        },
        "metadata": {
         "operationMetadataId": "cc7b73ae-a97a-4083-9c3e-3103f5c48c15"
        },
        "type": "Response",
        "kind": "Http",
        "inputs": {
         "statusCode": 200,
         "headers": {
          "Content-Type": "application/json"
         },
         "body": {
          "ok": true,
          "reference": "@{body('Create_notice')?['aaca_reference']}"
         }
        }
       },
       "Save_failed": {
        "runAfter": {
         "Create_notice": [
          "Failed",
          "TimedOut"
         ]
        },
        "metadata": {
         "operationMetadataId": "72e4f2a6-331b-459d-8ced-fb9aa6786f3a"
        },
        "type": "Response",
        "kind": "Http",
        "inputs": {
         "statusCode": 500,
         "headers": {
          "Content-Type": "application/json"
         },
         "body": {
          "ok": false,
          "error": "The absence could not be saved. Please call the school office."
         }
        }
       }
      },
      "else": {
       "actions": {
        "Invalid": {
         "runAfter": {},
         "metadata": {
          "operationMetadataId": "252b8db5-8195-437f-8c0a-c83d7aa7586e"
         },
         "type": "Response",
         "kind": "Http",
         "inputs": {
          "statusCode": 400,
          "headers": {
           "Content-Type": "application/json"
          },
          "body": {
           "ok": false,
           "error": "Missing or invalid name, school or dates."
          }
         }
        }
       }
      }
     }
    },
    "outputs": {}
   },
   "templateName": null
  },
  "schemaVersion": "1.0.0.0"
 }
}